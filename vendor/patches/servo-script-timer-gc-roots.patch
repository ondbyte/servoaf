+                if timers.is_empty() || timers.back().unwrap().scheduled_for > base_time {
+                    break;
+                }
 
-            if timers.is_empty() || timers.back().unwrap().scheduled_for > base_time {
-                break;
+                timers_to_run.push(timers.pop_back().unwrap());
             }
-
